<!-- The Kanakku UI kit's color tokens (Figma: Design System → variables). Light theme only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="Color.Primary">#7539FF</Color>
    <Color x:Key="Color.Primary700">#9781FF</Color>
    <Color x:Key="Color.PrimaryTransparent">#F8F5FF</Color>

    <!-- Greys: 900 for text, 500 for secondary text, 100 for borders, Light for fills -->
    <Color x:Key="Color.Grey900">#051321</Color>
    <Color x:Key="Color.Grey500">#5D6772</Color>
    <Color x:Key="Color.Grey300">#AAB0B6</Color>
    <Color x:Key="Color.Grey200">#C6CACE</Color>
    <Color x:Key="Color.Grey100">#E2E4E6</Color>
    <Color x:Key="Color.Light">#F7F8F9</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <!-- States, each with its pale background -->
    <Color x:Key="Color.Success">#27AE60</Color>
    <Color x:Key="Color.Success100">#E9F7EF</Color>
    <Color x:Key="Color.Warning">#E2B93B</Color>
    <Color x:Key="Color.Warning100">#FCF8EB</Color>
    <Color x:Key="Color.Error">#EF1E1E</Color>
    <Color x:Key="Color.Error100">#FDE9E9</Color>
    <Color x:Key="Color.Info">#2F80ED</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Primary700" Color="{StaticResource Color.Primary700}" />
    <SolidColorBrush x:Key="Brush.PrimaryTransparent" Color="{StaticResource Color.PrimaryTransparent}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Grey900}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.Grey500}" />
    <SolidColorBrush x:Key="Brush.Grey300" Color="{StaticResource Color.Grey300}" />
    <SolidColorBrush x:Key="Brush.Grey200" Color="{StaticResource Color.Grey200}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Grey100}" />
    <SolidColorBrush x:Key="Brush.Light" Color="{StaticResource Color.Light}" />
    <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Success100" Color="{StaticResource Color.Success100}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Warning100" Color="{StaticResource Color.Warning100}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Error100" Color="{StaticResource Color.Error100}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <!-- The kit's "Shadow – Medium": #5C5C5C at 8%, 4 down, 20 blur. -->
    <DropShadowEffect x:Key="Shadow.Medium" Color="#5C5C5C" Opacity="0.08" Direction="270"
                      ShadowDepth="4" BlurRadius="20" />

</ResourceDictionary>
