<!-- First start, laid out like the Kanakku kit's Login: the logo above a centered card with
     labeled fields and one full-width primary button. -->
<Window x:Class="Ordena.Frontend.Views.FirstRun.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
        xmlns:res="clr-namespace:Ordena.Frontend.Resources"
        Title="{x:Static res:Strings.FirstRun_WindowTitle}"
        Icon="{StaticResource Logo.Mark}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="14">

    <StackPanel Margin="40,32,40,40">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Image Source="{StaticResource Logo.Mark}" Width="32" Height="32" />
            <TextBlock Text="{x:Static res:Strings.App_Title}" FontSize="24" FontWeight="Bold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ContentControl Style="{StaticResource Card}" Focusable="False">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.FirstRun_Title}" Style="{StaticResource Text.Heading}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.FirstRun_Subtitle}" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,24" />

                <TextBlock Text="{x:Static res:Strings.FirstRun_Language}" Style="{StaticResource Text.Label}"
                           Margin="0,0,0,6" />
                <!-- Picking a language shows this window again in it (App.RunFirstRunAsync). -->
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{x:Static res:Strings.FirstRun_Language}"
                          Height="38" FontSize="14"
                          Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Border}" />

                <TextBlock Text="{x:Static res:Strings.FirstRun_Folder}" Style="{StaticResource Text.Label}"
                           Margin="0,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Field}">
                        <DockPanel>
                            <controls:Icon Data="{StaticResource Icon.Linear.Folder}" Size="16"
                                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ArchiveRoot}" ToolTip="{Binding ArchiveRoot}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                            Content="{x:Static res:Strings.FirstRun_ChangeFolder}" Command="{Binding ChooseFolderCommand}" />
                </Grid>
                <TextBlock Text="{x:Static res:Strings.FirstRun_FolderHint}" Style="{StaticResource Text.Small}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <Button Style="{StaticResource Button.Primary}" Margin="0,28,0,0" IsDefault="True"
                        Content="{x:Static res:Strings.FirstRun_Start}" Command="{Binding StartCommand}" />
            </StackPanel>
        </ContentControl>
    </StackPanel>
</Window>
