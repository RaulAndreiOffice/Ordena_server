<!-- The shell, laid out like the Kanakku kit's list screens: a sidebar of grouped pages on the left,
     the current page on the right, and a footer with the archive folder and the version.
     PDFs dropped anywhere on it go to the import queue. -->
<Window x:Class="Ordena.Frontend.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
        xmlns:behaviors="clr-namespace:Ordena.Frontend.Behaviors"
        xmlns:converters="clr-namespace:Ordena.Frontend.Converters"
        xmlns:res="clr-namespace:Ordena.Frontend.Resources"
        Title="{Binding WindowTitle}"
        Icon="{StaticResource Logo.Mark}"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="14"
        behaviors:FileDropBehavior.Command="{Binding FilesDroppedCommand}">

    <Window.Resources>
        <converters:ResourceKeyConverter x:Key="ResourceKey" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,20,10">
                    <Image Source="{StaticResource Logo.Mark}" Width="28" Height="28" />
                    <TextBlock Text="{x:Static res:Strings.App_Title}" Style="{StaticResource Text.PageTitle}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationSections}" AlternationCount="1000" Margin="16,8,16,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border x:Name="Divider" Height="1" Margin="0,8,0,16"
                                            Background="{StaticResource Brush.Border}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionLabel}"
                                               Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Checking it selects the entry, and MainViewModel navigates on that. -->
                                                <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Style="{StaticResource NavItem.Icon}"
                                                                       Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" />
                                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- A divider between sections, not above the first. -->
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                        <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page and footer -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Small}" />
                        <TextBlock Text=" · (made by mind2code)" ToolTip="(maide by mind2code)"
                                   Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextSecondary}"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ArchiveText}" Style="{StaticResource Text.Small}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="24" Focusable="False" />
        </DockPanel>

        <!-- While PDFs are dragged over the window. Not over the PDF preview: that is a separate native
             window, which WPF gets no drag events from, so the overlay going away shows a drop won't land. -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False"
              Visibility="{Binding (behaviors:FileDropBehavior.IsDragging), RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{StaticResource Brush.White}" Opacity="0.9" />
            <Rectangle Margin="16" RadiusX="8" RadiusY="8" Fill="{StaticResource Brush.PrimaryTransparent}" Opacity="0.6"
                       Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" StrokeDashArray="5 4" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                        Background="{StaticResource Brush.Primary}">
                    <controls:Icon Data="{StaticResource Icon.Linear.DocumentUpload}" Size="32"
                                   Foreground="{StaticResource Brush.White}" />
                </Border>
                <TextBlock Text="{x:Static res:Strings.Import_DropOverlay}" Style="{StaticResource Text.Heading}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
