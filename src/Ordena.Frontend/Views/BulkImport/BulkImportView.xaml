<!-- "Importar carpeta", a five-step wizard after the Kanakku kit's forms: the step header (the current step
     in purple), then one card per step with its actions in the card footer. The preview and partner grids
     sit in star-sized rows so they stay virtualized with thousands of files. -->
<UserControl x:Class="Ordena.Frontend.Views.BulkImport.BulkImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
             xmlns:converters="clr-namespace:Ordena.Frontend.Converters"
             xmlns:vm="clr-namespace:Ordena.Frontend.ViewModels"
             xmlns:dtos="clr-namespace:Ordena.Backend.Dtos;assembly=Ordena.Backend"
             xmlns:res="clr-namespace:Ordena.Frontend.Resources">

    <UserControl.Resources>
        <converters:EnumToLocalizedConverter x:Key="Localized" />

        <Style x:Key="TextInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.Light}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        </Style>
        <Style x:Key="ComboInput" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource Brush.Light}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <!-- The kit's form footer: a top line, the secondary action left, the primary right. -->
        <Style x:Key="Footer" TargetType="Border">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Padding" Value="0,16,0,0" />
        </Style>

        <!-- A row's status, colored like the kit's status tags. -->
        <DataTemplate x:Key="StatusTag">
            <Border x:Name="Pill" Style="{StaticResource Tag}" Background="{StaticResource Brush.Success100}">
                <TextBlock x:Name="Label" Text="{Binding Status, Converter={StaticResource Localized}}"
                           FontSize="12" FontWeight="Medium" Foreground="{StaticResource Brush.Success}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static dtos:BulkRowStatus.NotRecognized}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Light}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static dtos:BulkRowStatus.InvalidDate}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Error100}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static dtos:BulkRowStatus.CheckDate}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Warning100}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static dtos:BulkRowStatus.NumberExists}">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Warning100}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One step of the header: its number in a circle (purple when current) and its name. -->
        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="StepConnector" TargetType="Rectangle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource Brush.Grey200}" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{x:Static res:Strings.Bulk_Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Step header: 1 Carpeta — 2 Patrón — 3 Vista previa — 4 Proveedores — 5 Importar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Grey200}" BorderThickness="1">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Primary}"
                            Visibility="{Binding StepNumber, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Bulk_Step_Folder}" Style="{StaticResource Text.BodyMedium}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Rectangle Style="{StaticResource StepConnector}" />
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Grey200}" BorderThickness="1">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Primary}"
                            Visibility="{Binding StepNumber, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Bulk_Step_Pattern}" Style="{StaticResource Text.BodyMedium}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Rectangle Style="{StaticResource StepConnector}" />
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Grey200}" BorderThickness="1">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Primary}"
                            Visibility="{Binding StepNumber, Converter={StaticResource EqualsToVisibility}, ConverterParameter=3}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Bulk_Step_Preview}" Style="{StaticResource Text.BodyMedium}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Rectangle Style="{StaticResource StepConnector}" />
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Grey200}" BorderThickness="1">
                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Primary}"
                            Visibility="{Binding StepNumber, Converter={StaticResource EqualsToVisibility}, ConverterParameter=4}">
                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Bulk_Step_Partners}" Style="{StaticResource Text.BodyMedium}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Rectangle Style="{StaticResource StepConnector}" />
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Grey200}" BorderThickness="1">
                        <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Primary}"
                            Visibility="{Binding StepNumber, Converter={StaticResource EqualsToVisibility}, ConverterParameter=5}">
                        <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Bulk_Step_Import}" Style="{StaticResource Text.BodyMedium}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <ContentControl Style="{StaticResource Card}" Padding="24" Focusable="False">
            <Grid>
                <!-- 1. Carpeta -->
                <DockPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Folder}">
                    <Border Style="{StaticResource Footer}">
                        <Button Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Bulk_Analyze}"
                                Command="{Binding AnalyzeCommand}" HorizontalAlignment="Right" />
                    </Border>
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static res:Strings.Bulk_FolderTitle}" Style="{StaticResource Text.Heading}" />

                        <TextBlock Text="{x:Static res:Strings.Bulk_FolderLabel}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}" AutomationProperties.Name="{x:Static res:Strings.Bulk_Browse}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource Icon.Linear.Folder}" Size="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static res:Strings.Bulk_Browse}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static res:Strings.Bulk_FolderLabel}" />
                        </DockPanel>

                        <TextBlock Text="{x:Static res:Strings.Bulk_DirectionLabel}" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{x:Static res:Strings.Direction_Recibida}" IsChecked="{Binding IsReceived}" Margin="0,0,24,0" />
                            <RadioButton Content="{x:Static res:Strings.Direction_Emitida}" IsChecked="{Binding IsIssued}" />
                        </StackPanel>

                        <TextBlock Text="{x:Static res:Strings.Bulk_TypeLabel}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource ComboInput}" Width="300" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{x:Static res:Strings.Bulk_TypeLabel}" />

                        <CheckBox Content="{x:Static res:Strings.Bulk_PartnerFromFolder}" IsChecked="{Binding PartnerFromFolder}" Margin="0,20,0,0" />
                        <TextBlock Text="{x:Static res:Strings.Bulk_PartnerFromFolderHint}" Style="{StaticResource Text.Small}" Margin="28,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- 2. Patrón -->
                <DockPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pattern}">
                    <Border Style="{StaticResource Footer}">
                        <DockPanel>
                            <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_Back}" Command="{Binding BackCommand}" />
                            <Button Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Bulk_Next}"
                                    Command="{Binding NextCommand}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Static res:Strings.Bulk_PatternTitle}" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="{Binding MatchText}" Style="{StaticResource Text.BodyMedium}" Foreground="{StaticResource Brush.Primary}" Margin="0,6,0,0" />

                            <TextBlock Text="{x:Static res:Strings.Bulk_DetectedPatterns}" Style="{StaticResource FieldLabel}" />
                            <ListBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="{x:Static res:Strings.Bulk_DetectedPatterns}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PatternOption}">
                                        <Border Width="240" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MatchText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <CheckBox Content="{x:Static res:Strings.Bulk_UseCustomPattern}" IsChecked="{Binding UseCustomPattern}" Margin="0,16,0,0" />
                            <Grid Margin="28,8,0,0" IsEnabled="{Binding UseCustomPattern}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Style="{StaticResource TextInput}" Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" AutomationProperties.Name="{x:Static res:Strings.Bulk_UseCustomPattern}" />
                                <ComboBox Grid.Column="2" Style="{StaticResource ComboInput}" ItemsSource="{Binding DateFormats}"
                                          SelectedItem="{Binding CustomDateFormat}" AutomationProperties.Name="{x:Static res:Strings.Bulk_DateFormat}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Static res:Strings.Bulk_CustomPatternHelp}"
                                           Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding PatternError}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Margin="28,6,0,0"
                                       Visibility="{Binding PatternError, Converter={StaticResource NullToVisibility}}" />

                            <TextBlock Text="{x:Static res:Strings.Bulk_ExamplesTitle}" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Examples}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" FontFamily="Consolas" Margin="0,2" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 3. Vista previa -->
                <DockPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Preview}">
                    <Border Style="{StaticResource Footer}">
                        <DockPanel>
                            <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_Back}" Command="{Binding BackCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Bulk_Next}"
                                    Command="{Binding NextCommand}" />
                            <TextBlock Text="{Binding ImportCountText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,16,0" />
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboInput}" Width="220"
                                  ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{x:Static res:Strings.Bulk_Column_Status}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_UseFileDates}"
                                Command="{Binding IncludeFileDatesCommand}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Bulk_PreviewTitle}" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="{x:Static res:Strings.Bulk_PreviewHint}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <DataGrid Style="{StaticResource DataGrid.List}" IsReadOnly="False" ItemsSource="{Binding FilteredRows}"
                                  AutomationProperties.Name="{x:Static res:Strings.Bulk_PreviewTitle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Bulk_Column_Include}" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BulkRowViewModel}">
                                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}"
                                                      HorizontalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Bulk_Column_Include}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Bulk_Column_Status}" Width="150" IsReadOnly="True"
                                                        CellTemplate="{StaticResource StatusTag}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Bulk_Column_File}" Width="2*" IsReadOnly="True"
                                                    Binding="{Binding RelativePath}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Column_Date}" Width="120" Binding="{Binding DateText}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Column_Partner}" Width="2*" Binding="{Binding Partner}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Column_Number}" Width="*" Binding="{Binding Number}" />
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Type}" Width="200" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:BulkRowViewModel}">
                                            <ComboBox ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label"
                                                      Height="32" FontSize="13" BorderThickness="0" Background="Transparent"
                                                      AutomationProperties.Name="{x:Static res:Strings.Column_Type}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- 4. Proveedores -->
                <DockPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Partners}">
                    <Border Style="{StaticResource Footer}">
                        <DockPanel>
                            <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_Back}" Command="{Binding BackCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding ImportCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.Bulk_Import}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource Icon.Linear.DocumentUpload}" Size="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static res:Strings.Bulk_Import}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ImportCountText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,16,0" />
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{x:Static res:Strings.Bulk_PartnersTitle}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{x:Static res:Strings.Bulk_GroupsTitle}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Static res:Strings.Bulk_GroupsHint}" Style="{StaticResource Text.Small}" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Static res:Strings.Bulk_NoGroups}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PartnerGroupViewModel}">
                                        <Border Padding="12,8" Margin="0,0,0,6" CornerRadius="5" Background="{StaticResource Brush.Light}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Accept}" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding NamesText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding NamesText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                                <TextBox Grid.Column="3" Style="{StaticResource TextInput}" Background="{StaticResource Brush.White}"
                                                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Accept}"
                                                         AutomationProperties.Name="{x:Static res:Strings.Bulk_Column_ImportAs}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{x:Static res:Strings.Bulk_AllNames}" Style="{StaticResource FieldLabel}" />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <DataGrid Style="{StaticResource DataGrid.List}" IsReadOnly="False" ItemsSource="{Binding Partners}"
                                  AutomationProperties.Name="{x:Static res:Strings.Bulk_AllNames}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.Bulk_Column_Name}" Width="2*" IsReadOnly="True" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Bulk_Column_Files}" Width="100" IsReadOnly="True" Binding="{Binding Count, StringFormat=N0}" />
                                <DataGridTemplateColumn Width="150" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PartnerNameViewModel}">
                                            <Border Style="{StaticResource Tag}" Background="{StaticResource Brush.PrimaryTransparent}" ToolTip="{Binding ExistingName}"
                                                    Visibility="{Binding ExistingName, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{x:Static res:Strings.Bulk_Exists}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Brush.Primary}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.Bulk_Column_ImportAs}" Width="2*" Binding="{Binding Rename}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- 5. Importar: the progress -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560"
                            Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Running}">
                    <TextBlock Text="{x:Static res:Strings.Bulk_RunningTitle}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
                    <ProgressBar Height="8" Margin="0,20,0,10" Maximum="{Binding Total}" Value="{Binding Done}"
                                 Foreground="{StaticResource Brush.Primary}" AutomationProperties.Name="{x:Static res:Strings.Bulk_RunningTitle}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_Cancel}" Command="{Binding CancelCommand}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>

                <!-- 5. Importar: the report -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720"
                            Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Report}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <controls:Icon Data="{StaticResource Icon.Linear.TickCircle}" Size="24" Foreground="{StaticResource Brush.Success}" Margin="0,0,10,0" />
                        <TextBlock Text="{x:Static res:Strings.Bulk_ReportTitle}" Style="{StaticResource Text.Heading}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReportText}" Style="{StaticResource Text.BodyMedium}" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding LeftOutText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Bulk_SendToManual}"
                                Command="{Binding SendToManualCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_GoToSearch}"
                                Command="{Binding GoToSearchCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Bulk_StartOver}"
                                Command="{Binding StartOverCommand}" />
                    </WrapPanel>
                    <Border CornerRadius="8" Padding="16,12" Margin="0,24,0,0" Background="{StaticResource Brush.PrimaryTransparent}">
                        <DockPanel>
                            <controls:Icon Data="{StaticResource Icon.Linear.Info}" Size="18" Foreground="{StaticResource Brush.Primary}" Margin="0,0,10,0" />
                            <TextBlock Text="{x:Static res:Strings.Bulk_CheckArchive}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ContentControl>
    </DockPanel>
</UserControl>
