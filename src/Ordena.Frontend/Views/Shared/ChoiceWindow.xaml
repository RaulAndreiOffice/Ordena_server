<!-- A question with the app's own buttons ("Reintentar", "Buscar…", "Continuar"), where a message box only
     has Yes and No. The first choice is the main one: purple, on the right, and taken by Enter. -->
<Window x:Class="Ordena.Frontend.Views.Shared.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
        xmlns:res="clr-namespace:Ordena.Frontend.Resources"
        Title="{x:Static res:Strings.Dialog_Title}"
        Icon="{StaticResource Logo.Mark}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="14">

    <StackPanel Margin="28,24">
        <DockPanel>
            <controls:Icon Data="{StaticResource Icon.Linear.Info}" Size="24" Foreground="{StaticResource Brush.Primary}"
                           VerticalAlignment="Top" Margin="0,0,14,0" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
        </DockPanel>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0" />
    </StackPanel>
</Window>
