<!-- Editing one archived document: its PDF on the left, as on the import screen, and the same form on
     the right. Saving renames or moves the file to match. -->
<Window x:Class="Ordena.Frontend.Views.Shared.EditDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
        xmlns:shared="clr-namespace:Ordena.Frontend.Views.Shared"
        xmlns:res="clr-namespace:Ordena.Frontend.Resources"
        Title="{x:Static res:Strings.Edit_WindowTitle}"
        Icon="{StaticResource Logo.Mark}"
        Width="1100" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="14">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <ContentControl Style="{StaticResource Card}" Padding="6" Focusable="False">
            <controls:PdfPreview FilePath="{Binding PreviewPath}" />
        </ContentControl>

        <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="24" Focusable="False" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Edit_Title}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding FileText}" ToolTip="{Binding FileText}" Style="{StaticResource Text.Small}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <!-- Saving would fail: the file has to be found first (Buscar → Abrir). -->
                <Border CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderThickness="1"
                        Background="{StaticResource Brush.Warning100}" BorderBrush="{StaticResource Brush.Warning}"
                        Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <controls:Icon Data="{StaticResource Icon.Linear.Danger}" Size="18" VerticalAlignment="Top"
                                       Foreground="{StaticResource Brush.Warning}" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static res:Strings.Edit_FileMissing}" Style="{StaticResource Text.Small}"
                                   Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <shared:DocumentFormView DataContext="{Binding Form}" />

                <!-- The kit's form footer: the secondary action left, the primary right. -->
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                    <DockPanel>
                        <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Edit_Cancel}" IsCancel="True" />
                        <Button Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Edit_Save}"
                                Command="{Binding SaveCommand}" IsDefault="True" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>
