<!-- The search page, after the Kanakku kit's Purchase list: the title with the main action, a toolbar
     with the search box and the filters, and the table card with its count below. The grid sits in a
     star-sized row so it stays virtualized with thousands of documents. -->
<UserControl x:Class="Ordena.Frontend.Views.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
             xmlns:behaviors="clr-namespace:Ordena.Frontend.Behaviors"
             xmlns:converters="clr-namespace:Ordena.Frontend.Converters"
             xmlns:models="clr-namespace:Ordena.Backend.Models;assembly=Ordena.Backend"
             xmlns:res="clr-namespace:Ordena.Frontend.Resources">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:EnumToLocalizedConverter x:Key="Localized" />
        <converters:NullToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />

        <!-- The row actions, from the "⋯" button or a right-click. The menu isn't in the visual tree:
             it reaches the page's ViewModel through its placement target's Tag. -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="{x:Static res:Strings.Action_Open}" FontWeight="SemiBold"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static res:Strings.Action_ShowInFolder}"
                      Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static res:Strings.Action_Edit}" InputGestureText="F2"
                      Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Action_Delete}" InputGestureText="Supr" Foreground="{StaticResource Brush.Error}"
                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <Style x:Key="Row" TargetType="DataGridRow" BasedOn="{StaticResource DataGrid.Row}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
        </Style>

        <Style x:Key="FilterBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="{StaticResource Brush.White}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding GoToImportCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Search_ImportButton}">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{StaticResource Icon.Linear.DocumentUpload}" Size="16" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static res:Strings.Search_ImportButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Toolbar: the search box, then the filters -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="180"
                      ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:Strings.Filter_Direction}" />
            <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="190"
                      ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:Strings.Filter_Type}" />
            <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="140"
                      ItemsSource="{Binding Quarters}" SelectedItem="{Binding SelectedQuarter}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:Strings.Filter_Quarter}" />
            <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="150"
                      ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:Strings.Filter_Year}" />

            <Grid MinWidth="160">
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:FocusBehavior.Request="{Binding FocusRequest}"
                         AutomationProperties.Name="{x:Static res:Strings.Search_Placeholder}"
                         Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="34,0,8,0"
                         Background="{StaticResource Brush.White}" BorderBrush="{StaticResource Brush.Border}" />
                <controls:Icon Data="{StaticResource Icon.Linear.Search}" Size="16" HorizontalAlignment="Left" Margin="12,0,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}" IsHitTestVisible="False" />
                <TextBlock Text="{x:Static res:Strings.Search_Placeholder}" Style="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center" Margin="36,0,8,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Text, Converter={StaticResource EmptyToVisibility}}" />
            </Grid>
        </DockPanel>

        <!-- The table -->
        <ContentControl Grid.Row="2" Style="{StaticResource Card}" Padding="0" Focusable="False">
            <Grid>
                <DataGrid Style="{StaticResource DataGrid.List}" RowStyle="{StaticResource Row}" Margin="1"
                          ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}"
                          AutomationProperties.Name="{Binding Title}"
                          behaviors:DataGridBehavior.OpenCommand="{Binding OpenCommand}"
                          behaviors:DataGridBehavior.EditCommand="{Binding EditCommand}"
                          behaviors:DataGridBehavior.DeleteCommand="{Binding DeleteCommand}"
                          behaviors:DataGridBehavior.SortCommand="{Binding SortCommand}"
                          behaviors:DataGridBehavior.SortBy="{Binding SortBy}"
                          behaviors:DataGridBehavior.SortDescending="{Binding SortDescending}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Column_Date}" SortMemberPath="IssueDate" Width="120"
                                            Binding="{Binding IssueDate, StringFormat=d}" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Column_Partner}" SortMemberPath="Partner" Width="2*"
                                            Binding="{Binding PartnerName}" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Column_Number}" SortMemberPath="DocNumber" Width="*"
                                            Binding="{Binding DocNumber}" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Column_Type}" SortMemberPath="Type" Width="210"
                                            Binding="{Binding Type, Converter={StaticResource Localized}}" />
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Column_Direction}" SortMemberPath="Direction" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill" Style="{StaticResource Tag}" Background="{StaticResource Brush.PrimaryTransparent}">
                                        <TextBlock x:Name="Label" Text="{Binding Direction, Converter={StaticResource Localized}}"
                                                   FontSize="12" FontWeight="Medium" Foreground="{StaticResource Brush.Primary}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:Direction.Emitida}">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Success100}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="64" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Round}" HorizontalAlignment="Center"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ContextMenu="{StaticResource RowMenu}" behaviors:ContextMenuBehavior.OpenOnClick="True"
                                            AutomationProperties.Name="{x:Static res:Strings.Action_More}"
                                            ToolTip="{x:Static res:Strings.Action_More}">
                                        <controls:Icon Data="{StaticResource Icon.Linear.More}" Size="16" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nothing archived yet -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,0"
                            Visibility="{Binding IsArchiveEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.Search_Empty}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static res:Strings.Search_EmptyHint}" Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <Button Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Search_ImportButton}"
                            Command="{Binding GoToImportCommand}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Documents exist, none matches -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,0"
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.Search_NoMatches}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Filter_Clear}"
                            Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- The count, and "Limpiar filtros" while anything is typed or filtered. -->
        <DockPanel Grid.Row="3" Margin="2,12,0,0">
            <TextBlock DockPanel.Dock="Right" FontSize="13"
                       Visibility="{Binding HasCriteria, Converter={StaticResource BoolToVisibility}}">
                <Hyperlink Command="{Binding ClearFiltersCommand}" Foreground="{StaticResource Brush.Primary}"
                           TextDecorations="None"><Run Text="{x:Static res:Strings.Filter_Clear}" /></Hyperlink>
            </TextBlock>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" />
        </DockPanel>
    </Grid>
</UserControl>
