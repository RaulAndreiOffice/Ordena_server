<!-- Ajustes, a card per group as in the kit's settings forms: the language, then the invoices folder, its
     backups and "Comprobar carpeta" (ArchiveSettingsViewModel). -->
<UserControl x:Class="Ordena.Frontend.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ordena.Frontend.Controls"
             xmlns:res="clr-namespace:Ordena.Frontend.Resources">

    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="ListTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <!-- A list of what the check found, scrolling on its own past a few rows. -->
        <Style x:Key="FoundList" TargetType="ScrollViewer">
            <Setter Property="MaxHeight" Value="300" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- "Disponible" in green, "No disponible" in red. -->
        <Style x:Key="AvailabilityTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{StaticResource Brush.Success100}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Folder.IsAvailable}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.Error100}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvailabilityLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Folder.IsAvailable}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FoundRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,20" />

            <ContentControl Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_General}" Style="{StaticResource Text.Heading}" />

                    <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                              AutomationProperties.Name="{x:Static res:Strings.Settings_Language}"
                              Width="320" HorizontalAlignment="Left" Height="38" FontSize="14"
                              Background="{StaticResource Brush.Light}" BorderBrush="{StaticResource Brush.Border}" />
                    <TextBlock Text="{x:Static res:Strings.Settings_LanguageHint}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" />

                    <!-- Another language is saved but the texts are this run's: offer the restart. -->
                    <Border CornerRadius="8" Padding="16,12" Margin="0,20,0,0" Background="{StaticResource Brush.PrimaryTransparent}"
                            Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" VerticalAlignment="Center"
                                    Content="{x:Static res:Strings.Settings_RestartNow}" Command="{Binding RestartCommand}" Margin="16,0,0,0" />
                            <controls:Icon Data="{StaticResource Icon.Linear.Info}" Size="20" Foreground="{StaticResource Brush.Primary}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{x:Static res:Strings.Settings_RestartNeeded}" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <StackPanel DataContext="{Binding Archive}">
                <!-- The invoices folder -->
                <ContentControl Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_FolderTitle}" Style="{StaticResource Text.Heading}" />
                        <Border Style="{StaticResource Field}" Margin="0,16,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource AvailabilityTag}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource AvailabilityLabel}" />
                                </Border>
                                <controls:Icon Data="{StaticResource Icon.Linear.Folder}" Size="16"
                                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Folder.Root}" ToolTip="{Binding Folder.Root}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.Settings_FolderHint}" Style="{StaticResource Hint}" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Settings_ChangeLocation}"
                                    Command="{Binding ChangeLocationCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Settings_Move}"
                                    Command="{Binding MoveCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <!-- Backups -->
                <ContentControl Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_BackupTitle}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Text.BodyMedium}" Margin="0,16,0,0" />
                        <TextBlock Text="{x:Static res:Strings.Settings_BackupHint}" Style="{StaticResource Hint}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Settings_BackupNow}"
                                Command="{Binding BackupNowCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </ContentControl>

                <!-- Comprobar carpeta, and what it found -->
                <ContentControl Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_CheckTitle}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{x:Static res:Strings.Settings_CheckHint}" Style="{StaticResource Hint}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{x:Static res:Strings.Settings_Check}"
                                Command="{Binding CheckCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <StackPanel Visibility="{Binding HasCheckReport, Converter={StaticResource BoolToVisibility}}">
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CheckSummary}" Style="{StaticResource Text.BodyMedium}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RelinkedText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding RelinkedText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding HasMissingDocuments, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MissingTitle}" Style="{StaticResource ListTitle}" />
                                <TextBlock Text="{x:Static res:Strings.Settings_CheckMissingHint}" Style="{StaticResource Hint}" />
                                <ScrollViewer Style="{StaticResource FoundList}">
                                    <ItemsControl ItemsSource="{Binding MissingDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FoundRow}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                                                                Content="{x:Static res:Strings.Settings_LocateFile}" Margin="12,0,0,0"
                                                                Command="{Binding DataContext.LocateFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Document.RelativePath}" ToolTip="{Binding Document.RelativePath}"
                                                                       Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasUnknownFiles, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,20,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" VerticalAlignment="Center"
                                            Content="{x:Static res:Strings.Settings_Register}" Command="{Binding RegisterCommand}" />
                                    <TextBlock Text="{Binding UnknownTitle}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{x:Static res:Strings.Settings_CheckUnknownHint}" Style="{StaticResource Hint}" />
                                <ScrollViewer Style="{StaticResource FoundList}">
                                    <ItemsControl ItemsSource="{Binding UnknownFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FoundRow}">
                                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" Style="{StaticResource Text.Body}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <TextBlock Text="(made by mind2code.dev)" ToolTip="(made by mind2code.dev)" Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,20" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
